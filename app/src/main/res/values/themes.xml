<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema base (Compose pinta la UI; esto solo define la ventana) -->
    <style name="Theme.DynamicFrame" parent="android:Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Splash screen -->
    <style name="Theme.DynamicFrame.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.DynamicFrame</item>
    </style>
</resources>
